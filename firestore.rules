        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.requestId is string &&
        request.resource.data.action in [
          'creada','decisión','cotización','selección de cotización','evidencia',
          'invitación','cotización externa'
        ] &&
        request.resource.data.detail is string &&
        request.resource.data.detail.size() <= 500 &&
        request.resource.data.createdAt == request.time &&
        existsAfter(repairRequestPath(request.resource.data.requestId)) &&
        (canEdit() || getAfter(repairRequestPath(request.resource.data.requestId)).data.createdBy == request.auth.uid);
      allow update, delete: if false;
    }

    // Todas las demás colecciones permanecen cerradas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

