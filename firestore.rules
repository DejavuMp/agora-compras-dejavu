rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function userPath() {
      return /databases/$(database)/documents/agora_users/$(request.auth.uid);
    }
    function activeStaff() {
      return signedIn() && exists(userPath()) &&
        get(userPath()).data.active == true &&
        get(userPath()).data.role in ['admin', 'coordinador', 'consulta'];
    }
    function role() { return get(userPath()).data.role; }
    function canEdit() {
      return activeStaff() && role() in ['admin', 'coordinador'];
    }
    function isAdmin() { return activeStaff() && role() == 'admin'; }
    function validStaff() {
      return request.resource.data.keys().hasOnly(['email','name','role','active','createdAt','updatedAt']) &&
        request.resource.data.role in ['admin','coordinador','consulta'] &&
        request.resource.data.active is bool;
    }
    match /agora_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // El primer administrador se configura manualmente desde la consola Firebase.
      allow create, update: if isAdmin() && validStaff();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }
    match /agora_records/{record} {
      allow get, list: if activeStaff();
      allow create: if canEdit() &&
        request.resource.data.keys().hasOnly(['kind','recordId','payload','revision','updatedBy','updatedAt']) &&
        request.resource.data.keys().hasAll(['kind','recordId','payload','revision','updatedBy','updatedAt']) &&
        request.resource.data.kind in ['rfqs','orders','samples','suppliers','settings'] &&
        request.resource.data.recordId is string &&
        request.resource.data.revision == 1 &&
        request.resource.data.updatedBy == request.auth.uid;
      allow update: if canEdit() &&
        request.resource.data.keys().hasOnly(['kind','recordId','payload','revision','updatedBy','updatedAt']) &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.recordId == resource.data.recordId &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if canEdit();
    }
    // Un vínculo secreto de 256 bits concede acceso sólo a esta invitación.
    // El token no es enumerable y expira; nunca contiene credenciales de Firebase.
    function validInviteCreate() {
      return canEdit() &&
        request.resource.data.keys().hasOnly([
          'version','createdBy','createdAt','updatedAt','expiresAt','request',
          'status','receivedAt','receiver','submittedAt','response'
        ]) &&
        request.resource.data.keys().hasAll([
          'version','createdBy','createdAt','updatedAt','expiresAt','request',
          'status','receivedAt','receiver','submittedAt','response'
        ]) &&
        request.resource.data.version == 1 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        request.resource.data.request is map &&
        request.resource.data.request.items is list &&
        request.resource.data.request.items.size() <= 60 &&
        request.resource.data.request.id is string &&
        request.resource.data.request.kind in ['quote','sample','order'] &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.receivedAt == null &&
        request.resource.data.receiver == '' &&
        request.resource.data.submittedAt == null &&
        request.resource.data.response == null;
    }
    function publicTokenIsValid(token) {
      return token.matches('^[A-Za-z0-9_-]{43}$') &&
        resource.data.expiresAt > request.time &&
        resource.data.status in ['pendiente','recibida','cotizada'];
    }
    function validSupplierReceipt(token) {
      return publicTokenIsValid(token) &&
        resource.data.status == 'pendiente' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['receivedAt','receiver','status','updatedAt']) &&
        request.resource.data.status == 'recibida' &&
        request.resource.data.receivedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.receiver is string &&
        request.resource.data.receiver.size() > 1 &&
        request.resource.data.receiver.size() <= 120;
    }
    function validSupplierResponse(token) {
      return publicTokenIsValid(token) &&
        resource.data.status == 'recibida' &&
        resource.data.receivedAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['response','submittedAt','status','updatedAt']) &&
        request.resource.data.status == 'cotizada' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.response is map &&
        request.resource.data.response.keys().hasOnly(['company','email','general','items']) &&
        request.resource.data.response.company is string &&
        request.resource.data.response.company.size() <= 160 &&
        request.resource.data.response.email is string &&
        request.resource.data.response.email.size() <= 240 &&
        request.resource.data.response.general is map &&
        request.resource.data.response.items is list &&
        request.resource.data.response.items.size() <= 60;
    }
    match /provider_invites/{token} {
      allow get: if activeStaff() || publicTokenIsValid(token);
      allow list: if activeStaff();
      allow create: if token.matches('^[A-Za-z0-9_-]{43}$') && validInviteCreate();
      allow update: if validSupplierReceipt(token) || validSupplierResponse(token) ||
        (canEdit() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','updatedAt']) &&
          request.resource.data.status == 'revocada' &&
          request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin();
    }
    function deliveryPath(id) {
      return /databases/$(database)/documents/agora_file_deliveries/$(id);
    }
    function isActiveDelivery(id) {
      return id.matches('^[A-Za-z0-9_-]{43}$') &&
        exists(deliveryPath(id)) &&
        get(deliveryPath(id)).data.active == true &&
        get(deliveryPath(id)).data.validUntil > request.time;
    }
    function isDeliveryReadAllowed(token) {
      return token.matches('^[A-Za-z0-9_-]{43}$') &&
        resource.data.active == true &&
        resource.data.validUntil > request.time;
    }
    function validDeliveryData() {
      return request.resource.data.keys().hasOnly([
        'id','folio','createdBy','createdByEmail','createdAt','updatedAt','active',
        'version','revisions','project','category','title','recipientName',
        'recipientEmail','driveUrl','validUntil','notes','sampleImages','folderImages'
      ]) &&
      request.resource.data.keys().hasAll([
        'id','folio','createdBy','createdByEmail','createdAt','updatedAt','active',
        'version','revisions','project','category','title','recipientName',
        'recipientEmail','driveUrl','validUntil','notes','sampleImages','folderImages'
      ]) &&
      request.resource.data.id is string &&
      request.resource.data.title is string && request.resource.data.title.size() <= 160 &&
      request.resource.data.project is string && request.resource.data.project.size() <= 120 &&
      request.resource.data.recipientName is string && request.resource.data.recipientName.size() <= 120 &&
      request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.size() <= 240 &&
      request.resource.data.driveUrl is string && request.resource.data.driveUrl.size() <= 2048 &&
      request.resource.data.notes is string && request.resource.data.notes.size() <= 3000 &&
      request.resource.data.sampleImages is list && request.resource.data.sampleImages.size() <= 8 &&
      request.resource.data.folderImages is list && request.resource.data.folderImages.size() <= 6 &&
      request.resource.data.revisions is list && request.resource.data.revisions.size() <= 30 &&
      request.resource.data.validUntil is timestamp &&
      request.resource.data.version is int && request.resource.data.version >= 1 && request.resource.data.version <= 30 &&
      request.resource.data.active is bool;
    }
    match /agora_file_deliveries/{token} {
      allow get: if activeStaff() || isDeliveryReadAllowed(token);
      allow list: if activeStaff();
      allow create: if canEdit() && token.matches('^[A-Za-z0-9_-]{43}$') &&
        validDeliveryData() && request.resource.data.id == token &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByEmail == request.auth.token.email &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.active == true &&
        request.resource.data.version == 1 &&
        request.resource.data.revisions.size() == 1 &&
        request.resource.data.validUntil > request.time;
      allow update: if canEdit() && validDeliveryData() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdByEmail == resource.data.createdByEmail &&
        request.resource.data.recipientName == resource.data.recipientName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.recipientEmail == resource.data.recipientEmail &&
        request.resource.data.updatedAt == request.time &&
        (
          // Una nueva revisión conserva el enlace y registra versión posterior.
          (resource.data.active == true && request.resource.data.active == true &&
           request.resource.data.version == resource.data.version + 1 &&
           request.resource.data.revisions.size() == resource.data.revisions.size() + 1 &&
           request.resource.data.validUntil > request.time)
          ||
          // Revocación sin borrar el expediente.
          (resource.data.active == true && request.resource.data.active == false &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']))
        );
      allow delete: if false;
    }
    // El token está en el segmento de ruta: permite verificar incluso si NO existe
    // aún la respuesta. La colección de respuestas es de solo agregado.
    match /agora_file_responses/{token}/agora_file_reply_versions/{versionId} {
      allow get: if activeStaff() || isActiveDelivery(token);
      allow list: if activeStaff();
      allow create: if
        isActiveDelivery(token) &&
        request.resource.data.keys().hasOnly([
          'deliveryId','version','status','receiverName','receiverEmail','comments','createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'deliveryId','version','status','receiverName','receiverEmail','comments','createdAt'
        ]) &&
        request.resource.data.deliveryId == token &&
        request.resource.data.version is int &&
        versionId == string(request.resource.data.version) &&
        request.resource.data.version == get(deliveryPath(token)).data.version &&
        request.resource.data.status in ['recibido','no_recibido','cambios','aprobado'] &&
        request.resource.data.receiverName is string &&
        request.resource.data.receiverName.size() >= 2 && request.resource.data.receiverName.size() <= 120 &&
        request.resource.data.receiverEmail is string && request.resource.data.receiverEmail.size() <= 240 &&
        request.resource.data.comments is string && request.resource.data.comments.size() <= 3000 &&
        (request.resource.data.status in ['recibido','aprobado'] || request.resource.data.comments.size() >= 5) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Consulta global del historial para los usuarios internos, nunca para visitantes.
    match /{path=**}/agora_file_reply_versions/{versionId} {
      allow list: if activeStaff();
    }

    // Todas las demás colecciones permanecen cerradas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
