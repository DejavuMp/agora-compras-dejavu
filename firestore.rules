        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.revision == 1 &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.repairRoute == 'pendiente' &&
        request.resource.data.assignedTo == '' &&
        request.resource.data.decisionBy == '' &&
        request.resource.data.decisionNote == '' &&
        request.resource.data.estimatedCost == 0 &&
        request.resource.data.quotes.size() == 0 &&
        request.resource.data.photos.size() == 0 &&
        request.resource.data.selectedQuoteId == '';
      allow update: if repairUser() &&
        repairDocumentValid(id) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.revision == resource.data.revision + 1 &&
        (
          canEdit() ||
          (opsStaff() && resource.data.createdBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['photos','revision','updatedAt']) &&
            request.resource.data.photos.size() == resource.data.photos.size() + 1 &&
            request.resource.data.photos.hasAll(resource.data.photos) &&
            request.resource.data.photos[request.resource.data.photos.size() - 1].path
              .matches('^agora-repairs/' + id + '/' + request.auth.uid + '/[a-f0-9-]{36}\\.jpg$'))
        );
      allow delete: if false;
    }
    // Invitaciones individuales a proveedores. El token aleatorio de 256 bits
    // es la única llave pública: sin listados, sin acceso al expediente interno.
    function validRepairInviteRequest(token) {
      return canEdit() && token.matches('^[A-Za-z0-9_-]{43}
      allow get, list: if canEdit();
      allow create: if repairUser() &&
        request.resource.data.keys().hasOnly([
          'requestId','actorUid','actorEmail','action','detail','createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
